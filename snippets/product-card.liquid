{% comment %} Accepts: product {% endcomment %}
<a href="{{ product.url }}" class="card product-card">
  <div class="product-card__media">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
    {% else %}
      {% render 'placeholder-image', label: product.title %}
    {% endif %}
  </div>
  <div class="card__body">
    {% if product.type != blank %}<div class="product-card__type">{{ product.type }}</div>{% endif %}
    <h3 class="product-card__title">{{ product.title }}</h3>
    {% render 'price', product: product %}
  </div>
</a>
