<section class="section-pad" style="background:var(--c-herbal)">
  <div class="page-width" style="color:#fff">
    <div class="section-intro">
      <div class="eyebrow" style="color:var(--c-accent-light)">{{ section.settings.eyebrow }}</div>
      <h2 style="color:#fff">{{ section.settings.heading }}</h2>
      <p style="color:#DCE9DF">{{ section.settings.text }}</p>
    </div>
    <div class="grid grid--4">
      {% for block in section.blocks %}
        <div style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.18);border-radius:12px;padding:18px 20px" {{ block.shopify_attributes }}>
          <div class="sanskrit" style="font-size:19px;color:var(--c-accent-light)">{{ block.settings.sanskrit_name }}</div>
          <h4 style="color:#fff;margin:4px 0 6px">{{ block.settings.name }}</h4>
          <p style="font-size:13.5px;color:#DCE9DF;margin:0">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredient story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The pharmacopoeia" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Named in the texts. Tested in the lab." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Every herb we use has a classical citation and a modern lab report. Both are on the product page." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "sanskrit_name", "label": "Sanskrit name", "default": "अश्वगन्धा" },
        { "type": "text", "id": "name", "label": "Name", "default": "Ashwagandha" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Classical rasayana for strength and calm; studied today for stress and vitality support." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredient story",
      "blocks": [
        { "type": "ingredient", "settings": { "sanskrit_name": "शिलाजतु", "name": "Shilajit", "text": "Himalayan mineral resin, purified per classical method; standardised for fulvic acid in the lab." } },
        { "type": "ingredient", "settings": { "sanskrit_name": "अश्वगन्धा", "name": "Ashwagandha", "text": "Classical rasayana for strength and calm; studied today for stress and vitality support." } },
        { "type": "ingredient", "settings": { "sanskrit_name": "श्वेत मूसली", "name": "Safed Musli", "text": "Traditional vajikarana herb for vigour, named in the Bhavaprakasha." } },
        { "type": "ingredient", "settings": { "sanskrit_name": "गोक्षुर", "name": "Gokshura", "text": "Classical support for vitality and urinary health, cited across the samhitas." } }
      ]
    }
  ]
}
{% endschema %}
