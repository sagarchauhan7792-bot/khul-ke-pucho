<section class="section-pad">
  <div class="page-width">
    <div class="section-intro">
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="grid grid--3">
      {% if section.settings.blog != blank %}
        {% for article in section.settings.blog.articles limit: 3 %}
          <a href="{{ article.url }}" class="card product-card">
            {% if article.image %}
              {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title }}
            {% else %}
              {% render 'placeholder-image', label: article.title %}
            {% endif %}
            <div class="article-card__body">
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %b %Y' }}</time>
              <h3 class="product-card__title" style="margin-top:6px">{{ article.title }}</h3>
              <p style="font-size:14px;margin:0">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <div class="card"><div class="article-card__body"><p style="margin:0">Assign a blog to this section in the customizer.</p></div></div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog teasers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Khuli Baat" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Read before you worry" },
    { "type": "blog", "id": "blog", "label": "Blog" }
  ],
  "presets": [{ "name": "Blog teasers" }]
}
{% endschema %}
