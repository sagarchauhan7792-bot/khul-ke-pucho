<section class="section-pad">
  <div class="page-width">
    <div class="section-intro">
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    <div class="grid grid--3">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.limit %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <div class="card product-card">
            <div class="product-card__media">{% render 'placeholder-image', label: 'Assign a collection to this section' %}</div>
            <div class="card__body"><h3 class="product-card__title">Example product</h3><span class="price">₹0</span></div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
    {% if section.settings.cta_label != blank %}
      <div class="center" style="margin-top:30px">
        <a href="{{ section.settings.cta_link }}" class="btn btn--outline">{{ section.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Classical formulations" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lab-tested. Shastra-rooted." },
    { "type": "textarea", "id": "text", "label": "Intro text", "default": "Every batch is tested, every ingredient named, every claim substantiated. That is the only way we sell." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "View all products" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
