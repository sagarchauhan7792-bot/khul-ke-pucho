<section class="section-pad">
  <div class="page-width">
    <div class="iwt" {% if section.settings.reverse %}style="direction:rtl"{% endif %}>
      <div {% if section.settings.reverse %}style="direction:ltr"{% endif %}>
        {% if section.settings.image %}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.heading }}
        {% else %}
          {% render 'placeholder-image', label: 'TODO: upload image (ingredient macro, brass vessel, warm couple photo)' %}
        {% endif %}
      </div>
      <div {% if section.settings.reverse %}style="direction:ltr"{% endif %}>
        <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_link }}" class="btn btn--outline" style="margin-top:8px">{{ section.settings.cta_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our approach" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We treat causes, not symptoms" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Sleep, sugar, stress and circulation quietly shape intimate health. Our doctors look at the whole picture — then match classical formulations and daily practice to your case." },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
