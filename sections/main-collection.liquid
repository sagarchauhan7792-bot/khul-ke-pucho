<div class="page-width">
  <header class="collection-header">
    <div class="eyebrow">Collection</div>
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <p style="max-width:64ch">{{ collection.description }}</p>
    {% endif %}
  </header>

  <div class="grid grid--3 collection-grid">
    {% paginate collection.products by 12 %}
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p>No products here yet. Add products to this collection in the Shopify admin.</p>
      {% endfor %}
      {% if paginate.pages > 1 %}
        <div style="grid-column:1/-1" class="center">{{ paginate | default_pagination }}</div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Collection page",
  "settings": []
}
{% endschema %}
