<div class="page-width section-pad--tight">
  <header class="collection-header">
    <div class="eyebrow">Khuli Baat</div>
    <h1>{{ blog.title }}</h1>
  </header>
  <div class="grid grid--3" style="padding-bottom:50px">
    {% paginate blog.articles by 12 %}
      {% for article in blog.articles %}
        <a href="{{ article.url }}" class="card product-card">
          {% if article.image %}
            {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title }}
          {% else %}
            {% render 'placeholder-image', label: article.title %}
          {% endif %}
          <div class="article-card__body">
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %b %Y' }}</time>
            <h3 class="product-card__title" style="margin-top:6px">{{ article.title }}</h3>
            <p style="font-size:14px;margin:0">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          </div>
        </a>
      {% endfor %}
      {% if paginate.pages > 1 %}
        <div style="grid-column:1/-1" class="center">{{ paginate | default_pagination }}</div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
